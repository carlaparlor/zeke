vendor/

# A downloaded Go toolchain, if `zeke setup` had to fetch one.
.go/

# zeke runtime state when ZEKE_HOME points inside the checkout
# (bridge binaries and the token database live in $ZEKE_HOME/bin).
.zeke-home/
