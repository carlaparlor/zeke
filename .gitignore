node_modules/
dist/
*.log

# Extracted upstream reference sources — regenerated by scripts/extract-refs.sh
# from the committed zips. Kept out of git: 60 MB+ of vendored upstream code,
# not zeke's.
refs/

# Bridge source vendored by `zeke setup`. Regenerable from the committed
